# Comma-separated list of allowed frontend origins for CORS.
# (Any https://*.vercel.app preview is allowed automatically.)
ALLOWED_ORIGINS=https://drawr.vercel.app,http://localhost:5173

# Optional: Sentry DSN for backend error tracking (no-op if empty).
SENTRY_DSN=

# Deployment environment label (used by Sentry).
ENVIRONMENT=production

# Log verbosity.
LOG_LEVEL=INFO
